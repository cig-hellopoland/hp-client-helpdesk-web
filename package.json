{
  "name": "react-web-app",
  "version": "1.1.0",
  "description": "Template project for web applications.",
  "author": "Fream S.A.",
  "license": "MIT",
  "homepage": "https://git.fream.pl/fream/web/react-web-app/blob/master/README.md",
  "bugs": {
    "url": "https://git.fream.pl/fream/web/react-web-app/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@git.fream.pl:fream/web/react-web-app.git"
  },
  "engines": {
    "node": ">=8.15.0",
    "npm": ">=6.4.1"
  },
  "dependencies": {
    "@fream/axios-commons": "^2.0.0-beta.6",
    "@material-ui/core": "^3.9.1",
    "@material-ui/docs": "3.0.0-alpha.9",
    "@material-ui/icons": "^3.0.2",
    "@zeit/next-bundle-analyzer": "^0.1.2",
    "axios": "^0.18.0",
    "classnames": "^2.2.6",
    "cross-env": "^5.2.0",
    "express": "^4.16.4",
    "formik": "^1.4.3",
    "formik-material-ui": "0.0.16",
    "helmet": "^3.15.0",
    "http-proxy-middleware": "^0.19.1",
    "jss": "^9.8.7",
    "lodash": "^4.17.11",
    "nanoid": "^2.0.1",
    "next": "^7.0.2",
    "next-compose-plugins": "^2.1.1",
    "nprogress": "^0.2.0",
    "prop-types": "^15.6.2",
    "react": "^16.7.0",
    "react-dom": "^16.7.0",
    "react-jss": "^8.6.1",
    "react-redux": "^6.0.0",
    "redux": "^4.0.1",
    "redux-devtools-extension": "^2.13.7",
    "redux-logic": "^2.1.1",
    "rxjs": "^6.4.0",
    "styled-jsx": "^3.2.0",
    "yup": "^0.26.10"
  },
  "devDependencies": {
    "babel-eslint": "^10.0.1",
    "babel-plugin-module-resolver": "^3.1.3",
    "eslint": "^5.12.1",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-import-resolver-babel-module": "^5.0.1",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-jsx-a11y": "^6.2.0",
    "eslint-plugin-react": "^7.12.4",
    "jest": "^24.0.0",
    "jest-dom": "^3.0.1",
    "jsdoc": "^3.5.5",
    "jsdoc-to-markdown": "^4.0.1",
    "json-server": "^0.14.2",
    "react-testing-library": "^5.4.4",
    "rimraf": "^2.6.3"
  },
  "scripts": {
    "analyze": "cross-env BUNDLE_ANALYZE=browser next build",
    "audit": "npm audit --registry=https://registry.npmjs.org/",
    "build": "next build",
    "dev": "node ./server/server.js",
    "jsdoc": "rimraf ./jsdoc && jsdoc -r -c ./jsdoc.json -d ./jsdoc ./",
    "jsdoc2md": "jsdoc2md -c ./jsdoc.json -f **/*.js **/*.jsx  > jsdoc/app-spec.md",
    "lint": "eslint . --ext .js,.jsx --ignore-path .gitignore --cache",
    "lint-fix": "npm run lint -- --fix",
    "postinstall": "npm run audit",
    "server-mock": "node ./__mocks__/mock-server.js",
    "start": "cross-env NODE_ENV=production node ./server/server.js",
    "test": "jest",
    "test-watch": "npm test -- --watch"
  }
}
