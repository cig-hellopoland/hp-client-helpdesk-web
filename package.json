    "@material-ui/docs": "1.0.0-alpha.5",
    "@material-ui/icons": "^3.0.1",
    "@zeit/next-bundle-analyzer": "^0.1.2",
    "axios": "^0.18.0",
    "classnames": "^2.2.6",
    "cross-env": "^5.1.6",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "express": "^4.16.3",
    "helmet": "^3.13.0",
    "http-proxy-middleware": "^0.19.0",
    "jest": "^23.0.1",
    "jss": "^9.8.1",
    "lodash": "^4.17.10",
    "nanoid": "^1.2.4",
